{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Preview landing page",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "start-preview",
      "serverReadyAction": {
        "pattern": "Server running at.*http://localhost:3000",
        "uriFormat": "http://localhost:3000",
        "action": "openExternally"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
