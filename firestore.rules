rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        (request.auth.token.email == 'marilynnlward@gmail.com' ||
         request.auth.token.email == 'springboardforcommunitydev@gmail.com' ||
         request.auth.token.email == 'info@springboardsfcd.org');
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'program', 'createdAt']) &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.program is string && data.program.size() >= 1 && data.program.size() <= 100;
    }

    function isValidCandidate(data) {
      return data.keys().hasAll(['name', 'trade', 'createdAt']) &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.trade is string && data.trade.size() >= 2 && data.trade.size() <= 120;
    }

    function isValidVolunteer(data) {
      return data.keys().hasAll(['name', 'availability', 'interest', 'createdAt']) &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.availability is string && data.availability.size() <= 60 &&
             data.interest is string && data.interest.size() <= 80;
    }

    match /programInquiries/{docId} {
      allow create: if isValidInquiry(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /candidateApplications/{docId} {
      allow create: if isValidCandidate(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /volunteerSignups/{docId} {
      allow create: if isValidVolunteer(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /roadmapProgress/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}