{
  "entities": {
    "Transitional_Prospect": {
      "title": "Transitional Prospect Profile",
      "description": "In-progress profile document and goal-tracking state for transitional trade training candidates",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique identifier of the prospect, linked to anonymous Firebase Auth UID"
        },
        "currentStep": {
          "type": "string",
          "maxLength": 50,
          "description": "Current active step in conversational goal tracking flow"
        },
        "trade": {
          "type": "string",
          "maxLength": 100,
          "description": "Selected vocational trade pathway"
        },
        "primaryGoal": {
          "type": "string",
          "maxLength": 200,
          "description": "Primary goal for joining the transitional jobs program"
        },
        "timeline": {
          "type": "string",
          "maxLength": 100,
          "description": "Target timeline for entering workforce or starting training"
        },
        "careerCenter": {
          "type": "string",
          "maxLength": 150,
          "description": "Status with local Career Center (Valley, Opelika, Phenix City, or needing registration)"
        },
        "backgroundStatus": {
          "type": "string",
          "maxLength": 100,
          "description": "Self-identified background status (e.g. Returning Citizen, Opportunity Youth, Career Changer)"
        },
        "transportation": {
          "type": "string",
          "maxLength": 100,
          "description": "Transportation access status"
        },
        "firstName": {
          "type": "string",
          "maxLength": 50,
          "description": "First name of candidate"
        },
        "lastName": {
          "type": "string",
          "maxLength": 50,
          "description": "Last name of candidate"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Full name of the prospect"
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Contact phone number"
        },
        "email": {
          "type": "string",
          "maxLength": 120,
          "description": "Contact email address"
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Additional notes, questions, or specific scheduling needs"
        },
        "status": {
          "type": "string",
          "enum": ["in_progress", "completed", "submitted"],
          "description": "Current lifecycle status of the prospect intake document"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when prospect profile was initiated"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when prospect profile was last updated"
        }
      },
      "required": ["uid", "status"]
    },
    "ProgramInquiry": {
      "title": "Program Inquiry",
      "description": "General trade training inquiry submission",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100, "description": "Full name of inquirer" },
        "email": { "type": "string", "maxLength": 120, "description": "Contact email" },
        "phone": { "type": "string", "maxLength": 30, "description": "Contact phone" },
        "program": { "type": "string", "maxLength": 50, "description": "Inquired program (Learn, Train, Build)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Submission timestamp" }
      },
      "required": ["name", "program"]
    },
    "VolunteerSignup": {
      "title": "Volunteer Signup",
      "description": "Community volunteer interest signup submission",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100, "description": "Full name of volunteer" },
        "email": { "type": "string", "maxLength": 120, "description": "Contact email" },
        "phone": { "type": "string", "maxLength": 30, "description": "Contact phone" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Submission timestamp" }
      },
      "required": ["name"]
    }
  },
  "firestore": {
    "/Transitional_Prospects/{prospectId}": {
      "schema": {
        "$ref": "#/entities/Transitional_Prospect"
      },
      "description": "Stores in-progress transitional job prospect profiles and conversational goal-tracking records"
    },
    "/programInquiries/{inquiryId}": {
      "schema": {
        "$ref": "#/entities/ProgramInquiry"
      },
      "description": "Public trade program inquiries"
    },
    "/volunteerSignups/{signupId}": {
      "schema": {
        "$ref": "#/entities/VolunteerSignup"
      },
      "description": "Public volunteer signups"
    }
  }
}
