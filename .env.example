# Server & Domain Configuration
PORT=3000
NODE_ENV=production
APP_URL=https://springboardsfcd.org
ALLOWED_ORIGINS=https://springboardsfcd.org,https://www.springboardsfcd.org,https://springboards-backend--springboards-community-dev.us-east4.hosted.app,https://springboards-community-dev.web.app

# Designated Workforce & Alert Routing Inboxes
DESIGNATED_INBOX=marilynnlward@gmail.com
HR_INBOX=marilynnlward@gmail.com
ALERT_EMAIL=marilynnlward@gmail.com
BACKUP_ALERT_EMAIL=marilynnlward@gmail.com
WORKSPACE_CONNECTED_EMAIL=marilynnlward@gmail.com

# Executive Backoffice Authentication & Session Security
ADMIN_ALLOWED_EMAILS=marilynnlward@gmail.com,springboardforcommunitydev@gmail.com
ADMIN_PASSCODE=
STAFF_DEFAULT_PIN=
ADMIN_SESSION_SECRET=

# Firebase & Google Cloud Configuration (Defaults configured in apphosting.yaml & firebase.json)
FIREBASE_PROJECT_ID=springboards-community-dev
# APPHOSTING_BACKEND_ID=springboards-backend
# APPHOSTING_REGION=us-east4
# APPHOSTING_HOSTED_DOMAIN=springboards-backend--springboards-community-dev.us-east4.hosted.app

# Analytics & SMTP Transport
ANALYTICS_ENABLED=true
SMTP_HOST=smtp.gmail.com
